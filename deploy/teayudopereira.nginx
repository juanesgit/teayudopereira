server {
    listen 80;
    server_name teayudopereira.com www.teayudopereira.com;

    # Redirigir todo a HTTPS (certbot lo activa después)
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl;
    server_name teayudopereira.com www.teayudopereira.com;

    # Certificados SSL (certbot los llena automáticamente)
    ssl_certificate     /etc/letsencrypt/live/teayudopereira.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/teayudopereira.com/privkey.pem;
    include             /etc/letsencrypt/options-ssl-nginx.conf;
    ssl_dhparam         /etc/letsencrypt/ssl-dhparams.pem;

    client_max_body_size 20M;

    # Archivos estáticos (fotos subidas)
    location /static/ {
        alias /home/deploy/teayudopereira/backend/static/;
        expires 7d;
        add_header Cache-Control "public";
    }

    # Todo lo demás va al backend FastAPI
    location / {
        proxy_pass         http://127.0.0.1:8002;
        proxy_http_version 1.1;
        proxy_set_header   Host              $host;
        proxy_set_header   X-Real-IP         $remote_addr;
        proxy_set_header   X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header   X-Forwarded-Proto $scheme;
        proxy_read_timeout 60s;
    }
}
